<nav class="navbar">
  <!-- Logo / Brand -->
  <a href="/" class="navbar__logo">
    🎟 Smart<span>Events</span>
  </a>

  <!-- Navigation Links -->
  <ul class="navbar__links">
    <li><a href="/" class="<%= page === 'home' ? 'active' : '' %>">Events</a></li>

    <% if (user) { %>
      <li><a href="/bookings" class="<%= page === 'bookings' ? 'active' : '' %>">My Bookings</a></li>
      <li><a href="/contact" class="<%= page === 'contact' ? 'active' : '' %>">Contact</a></li>

      <% if (user.role === 'admin') { %>
        <li><a href="/admin" class="<%= page === 'admin' ? 'active' : '' %>">Admin</a></li>
      <% } %>

      <li><span class="text-muted" style="color:#9ca3af; font-size:0.85rem;">Hi, <%= user.name %></span></li>
      <li>
        <form action="/auth/logout" method="POST" style="display:inline;">
          <button type="submit" class="btn btn-nav btn-outline" style="border-color:#9ca3af; color:#9ca3af; padding:0.35rem 0.9rem; font-size:0.85rem;">
            Logout
          </button>
        </form>
      </li>

    <% } else { %>
      <!-- Show login/register when NOT logged in -->
      <li><a href="/auth/login" class="<%= page === 'login' ? 'active' : '' %>">Login</a></li>
      <li><a href="/auth/register" class="btn-nav btn">Register</a></li>
    <% } %>
  </ul>
</nav>
