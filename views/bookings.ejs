<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>User Dashboard</title>
    <link rel="stylesheet" href="/css/style.css"/>
</head>
<style>
  .main-content {
    padding: 2rem;
    background: #f4f7fb;
    min-height: 100vh;
  }

  .topbar {
    margin-bottom: 2rem;
  }

  .topbar h1 {
    font-size: 2rem;
    color: var(--primary);
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .stat-card {
    background: linear-gradient(135deg, var(--primary), #0f3460);
    color: white;
    padding: 1.8rem;
    border-radius: 24px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
  }

  .stat-card::before {
    content: "";
    position: absolute;
    width: 10rem;
    height: 10rem;
    background: rgba(255,255,255,0.06);
    border-radius: 50%;
    top: -4rem;
    right: -4rem;
  }

  .stat-card h3 {
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 0.7rem;
    color: #cbd5e1;
  }

  .stat-card p {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
  }

  .booking-section,
  .history-section {
    margin-bottom: 2.5rem;
  }

  .section-header,
  .history-section h2 {
    margin-bottom: 1.5rem;
  }

  .section-header h2,
  .history-section h2 {
    color: var(--primary);
    font-size: 1.3rem;
  }

  .event-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .event-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
    transition: 0.25s ease;
  }

  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.1);
  }

  .event-image {
    height: 12rem;
    background: linear-gradient(135deg, var(--accent), #0f3460);
    position: relative;
  }

  .event-image::after {
    content: "🎟";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 3rem;
    color: rgba(255,255,255,0.85);
  }

  .event-content {
    padding: 1.5rem;
  }

  .event-content h3 {
    margin-bottom: 0.7rem;
    color: var(--primary);
    font-size: 1.1rem;
  }

  .event-content p {
    color: #64748b;
    margin-bottom: 0.5rem;
    font-size: 0.92rem;
  }

  .primary-btn {
    margin-top: 1rem;
    width: 100%;
    border: none;
    padding: 0.9rem;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--accent), #7c3aed);
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: 0.25s ease;
  }

  .primary-btn:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  }

  thead {
    background: linear-gradient(135deg, var(--primary), #0f3460);
    color: white;
  }

  th {
    padding: 1rem;
    text-align: left;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  td {
    padding: 1rem;
    border-bottom: 1px solid #edf2f7;
    color: #475569;
    font-size: 0.92rem;
  }

  tbody tr:hover {
    background: #f8fafc;
  }

  .status {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    display: inline-flex;
  }

  .status.active {
    background: rgba(34, 197, 94, 0.12);
    color: #16a34a;
  }

  .status.full {
    background: rgba(59, 130, 246, 0.12);
    color: #2563eb;
  }

  @media (max-width: 768px) {
    .main-content {
      padding: 1.2rem;
    }

    table {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }
  }
</style>
<body>

    <%- include('partials/navbar') %>

    <main class="main-content">

        <div class="topbar">
            <h1>Welcome Back, <%= user.name %> 👋</h1>
        </div>

        <section class="stats-grid">

            <div class="stat-card">
                <h3>Total Bookings</h3>
                <p>12</p>
            </div>

            <div class="stat-card">
                <h3>Upcoming Events</h3>
                <p>5</p>
            </div>

            <div class="stat-card">
                <h3>Tickets Used</h3>
                <p>7</p>
            </div>

        </section>

        <section class="booking-section">

            <div class="section-header">
                <h2>Available Events</h2>
            </div>

            <div class="event-cards">

                <div class="event-card">
                    <div class="event-image"></div>

                    <div class="event-content">
                        <h3>Future Beats Festival</h3>
                        <p>25 July 2026</p>
                        <p>Tickets Left: 120</p>

                        <button class="primary-btn">
                            Book Ticket
                        </button>
                    </div>
                </div>

                <div class="event-card">
                    <div class="event-image"></div>

                    <div class="event-content">
                        <h3>Business Growth Summit</h3>
                        <p>14 August 2026</p>
                        <p>Tickets Left: 45</p>

                        <button class="primary-btn">
                            Book Ticket
                        </button>
                    </div>
                </div>

            </div>

        </section>

        <section class="history-section">

            <h2>Booking History</h2>

            <table>

                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Ticket ID</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>Design Expo</td>
                        <td>10 April 2026</td>
                        <td><span class="status active">Confirmed</span></td>
                        <td>#AE2910</td>
                    </tr>

                    <tr>
                        <td>Startup Meetup</td>
                        <td>18 March 2026</td>
                        <td><span class="status full">Completed</span></td>
                        <td>#AE1832</td>
                    </tr>

                </tbody>

            </table>

        </section>

    </main>

</body>
</html>