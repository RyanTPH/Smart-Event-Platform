<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Events | SmartEvents</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />

    <style>
      .hero {
        background: linear-gradient(135deg, var(--primary) 0%, #0f3460 100%);
        color: #ffffff;
        padding: 3rem 1.5rem;
        text-align: center;
      }

      .hero h1 {
        font-size: 2.2rem;
        color: #ffffff;
        margin-bottom: 0.6rem;
      }

      .hero p {
        color: #9ca3af;
        margin-bottom: 1.5rem;
      }

      .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 1rem;
      }

      .filter-bar input,
      .filter-bar select {
        padding: 0.55rem 0.9rem;
        border-radius: 8px;
        border: none;
        font-family: var(--font-body);
        font-size: 0.9rem;
        background-color: #ffffff;
        color: var(--text);
        outline: none;
        min-width: 180px;
      }

      .filter-bar button {
        padding: 0.55rem 1.2rem;
        background-color: var(--accent);
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-family: var(--font-body);
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
      }

      .filter-bar button:hover {
        background-color: var(--accent-hover);
      }

      .section-heading {
        font-size: 1.3rem;
        margin-bottom: 1.2rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--border);
      }

      .events-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .event-card {
        background-color: var(--card-bg);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        border: 1px solid var(--border);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .event-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
      }

      .event-card__top {
        height: 6px;
        background-color: var(--accent);
      }

      .event-card__body {
        padding: 1.2rem;
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      .event-card__category {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--accent);
        margin-bottom: 0.4rem;
      }

      .event-card__title {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }

      .event-card__meta {
        font-size: 0.83rem;
        color: var(--text-muted);
        margin-bottom: 0.3rem;
      }

      .event-card__footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border);
      }

      .event-card__price {
        font-weight: 700;
        font-size: 1rem;
        color: var(--primary);
      }

      .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--text-muted);
      }

      .empty-state p {
        font-size: 1.1rem;
        margin-top: 0.5rem;
      }
    </style>
  </head>

  <body>
    <%- include('partials/navbar') %>

    <section class="hero">
      <h1>Find Your Next Event 🎉</h1>
      <p>Browse, search, and book tickets for events near you.</p>

      <form action="/" method="GET">
        <div class="filter-bar">
          <input
            type="text"
            name="search"
            placeholder="Search events..."
            value="<%= search || '' %>"
          />

          <select name="category">
            <option value="">All Categories</option>
            <option value="Music" <%= category === 'Music' ? 'selected' : '' %>>Music</option>
            <option value="Tech" <%= category === 'Tech' ? 'selected' : '' %>>Tech</option>
            <option value="Sports" <%= category === 'Sports' ? 'selected' : '' %>>Sports</option>
            <option value="Arts" <%= category === 'Arts' ? 'selected' : '' %>>Arts</option>
            <option value="Business" <%= category === 'Business' ? 'selected' : '' %>>Business</option>
            <option value="Food" <%= category === 'Food' ? 'selected' : '' %>>Food & Drink</option>
          </select>

          <input
            type="date"
            name="date"
            value="<%= date || '' %>"
          />

          <select name="availability">
            <option value="">All Availability</option>
            <option value="available" <%= availability === 'available' ? 'selected' : '' %>>Available</option>
            <option value="soldout" <%= availability === 'soldout' ? 'selected' : '' %>>Sold Out</option>
          </select>

          <button type="submit">🔍 Search</button>

          <% if (search || category || date || availability) { %>
            <a href="/" style="color:#9ca3af; font-size:0.85rem; align-self:center;">Clear</a>
          <% } %>
        </div>
      </form>
    </section>

    <div class="page-wrapper">

      <% if (successMsg) { %>
        <div class="alert alert-success"><%= successMsg %></div>
      <% } %>
      <% if (errorMsg) { %>
        <div class="alert alert-error"><%= errorMsg %></div>
      <% } %>

      <h2 class="section-heading">
        <%= events.length %> Event<%= events.length !== 1 ? 's' : '' %> Found
      </h2>

      <% if (events.length > 0) { %>
        <div class="events-grid">

          <% events.forEach(function(event) { %>
            <div class="event-card">
              <div class="event-card__top"></div>

              <div class="event-card__body">
                <span class="event-card__category"><%= event.category %></span>

                <h3 class="event-card__title"><%= event.title %></h3>

                <p class="event-card__meta">📅 <%= new Date(event.date).toDateString() %></p>
                <p class="event-card__meta">📍 <%= event.location %></p>

                <!-- Availability status -->
                <p class="event-card__meta mt-1">
                  <% if (event.availableTickets > 0) { %>
                    <span class="badge badge-success"><%= event.availableTickets %> tickets left</span>
                  <% } else { %>
                    <span class="badge badge-danger">Sold Out</span>
                  <% } %>
                </p>

                <!-- Price and booking action -->
                <div class="event-card__footer">
                  <span class="event-card__price">
                    <% if (event.price === 0) { %>
                      Free
                    <% } else { %>
                      R<%= event.price %>
                    <% } %>
                  </span>

                  <% if (user) { %>
                    <% if (event.availableTickets > 0) { %>
                      <a href="/bookings/new/<%= event._id %>" class="btn btn-primary btn-sm">Book Now</a>
                    <% } else { %>
                      <button class="btn btn-sm" disabled style="background:#e5e7eb; color:#9ca3af; cursor:not-allowed;">Sold Out</button>
                    <% } %>
                  <% } else { %>
                    <a href="/auth/login" class="btn btn-outline btn-sm">Login to Book</a>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>

        </div>

      <% } else { %>
        <!-- No results fallback -->
        <div class="empty-state">
          <p style="font-size:2.5rem;">🔍</p>
          <p>No events found. Try adjusting your filters.</p>
          <a href="/" class="btn btn-outline mt-2">Clear Filters</a>
        </div>
      <% } %>

    </div>

    <%- include('partials/footer') %>
  </body>
</html>

